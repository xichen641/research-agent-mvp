ENVIRONMENT=development
API_HOST_PORT=8000
WEB_HOST_PORT=3000
POSTGRES_HOST_PORT=5432
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
PROMETHEUS_HOST_PORT=9090
DATABASE_URL=postgresql+asyncpg://research:research@postgres:5432/research
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=research
MINIO_SECRET_KEY=research-secret
MINIO_BUCKET=research-agent
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
WEB_ORIGIN=http://127.0.0.1:3000
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=10
RERANKER_BASE_URL=https://WORKSPACE_ID.cn-beijing.maas.aliyuncs.com
RERANKER_API_KEY=
RERANKER_MODEL=qwen3-rerank
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.7-plus
LLM_TIMEOUT_SECONDS=180
MEMORY_MAX_CONTEXT_TOKENS=6000
MEMORY_RECENT_MESSAGE_TOKENS=2500
# Legacy MEMORY_* names now use conservative UTF-8 byte units (not native tokens).
# CHAT_CONTEXT_BUDGET accepts a JSON object; omitted fields use validated defaults.
# Each run freezes this policy. Output is also enforced through native max_tokens.
# CHAT_CONTEXT_BUDGET={"window":32768,"output":4096,"preparation_calls":32,"preparation_seconds":60}
CHAT_RUN_LEASE_SECONDS=1800
CHAT_RECOVERY_BATCH_SIZE=20
ARXIV_API_URL=https://export.arxiv.org/api/query
ARXIV_USER_AGENT=ResearchAgent/0.1 (local research platform)
ARXIV_TIMEOUT_SECONDS=30
ARXIV_CACHE_HOURS=24
ARXIV_MAX_PDF_BYTES=52428800
